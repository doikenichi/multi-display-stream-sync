{
  "name": "display-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "playwright test",
    "test:integration:headed": "playwright test --headed",
    "test:integration:debug": "playwright test --debug",
    "coverage:integration:clean": "node -e \"const fs=require('node:fs'); fs.rmSync('.nyc_output',{recursive:true,force:true}); fs.rmSync('coverage/integration',{recursive:true,force:true});\"",
    "test:integration:coverage": "npm run coverage:integration:clean && cross-env VITE_COVERAGE=true playwright test && nyc report --temp-dir .nyc_output --report-dir coverage/integration --reporter=text --reporter=html --reporter=lcov",
    "coverage:integration:report": "nyc report --reporter=text --reporter=html --reporter=lcov",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.8",
    "shaka-player": "5.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "10.1.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "nyc": "18.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.1.5",
    "vite-plugin-istanbul": "9.0.1",
    "vitest": "^4.1.10"
  }
}
